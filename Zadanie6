import random

droga = random.randint(10, 500)
spalanie = float(input("Podaj średnie spalanie na 100 km: "))
cena_paliwa = float(input("Podaj cenę paliwa za litr: "))

zuzyte_paliwo = (droga * spalanie) / 100
koszt = zuzyte_paliwo * cena_paliwa

print(f"Wylosowana droga: {droga} km")
print(f"Przewidywane zużycie paliwa: {round(zuzyte_paliwo, 2)} l")
print(f"Szacowany koszt: {round(koszt, 2)} zł")
